# ============================================================
# HƯỚNG DẪN CẤU HÌNH
# ============================================================
# 1. Copy file này thành .env (bỏ .sample)
# 2. Thay thế các giá trị your_xxx_here bằng giá trị thực
# 3. Lưu file và restart server
# ============================================================

# ======================
# Database Configuration
# ======================
DB_HOST=localhost
DB_PORT=27017
DB_USERNAME=admin
DB_PASSWORD=123456
DB_NAME=law_chatbot

# Alternative: Use full MongoDB URI (overrides above settings)
# MONGO_URI=mongodb://admin:123456@localhost:27017/law_chatbot?authSource=admin

# ======================
# LLM Configuration (QUAN TRỌNG!)
# ======================
# Gemini API - Lấy key miễn phí tại: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ======================
# Vector Database (ChromaDB)
# ======================
# Backend type: chroma (khuyến nghị), in-memory, qdrant
VECTOR_DB_BACKEND=chroma

# ChromaDB settings
CHROMA_PERSIST_DIRECTORY=./storage/chroma
USE_GOOGLE_EMBEDDING=false

# ======================
# Application Settings
# ======================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# ======================
# Agent Configuration
# ======================
# Enable/disable planner
ENABLE_PLANNER=true

# Use conversation history
USE_CONVERSATION_HISTORY=true

# Max iterations for function calling
MAX_ITERATIONS=10

# ======================
# Worker Configuration
# ======================
WORKER_COUNT=5
WORKER_POLL_INTERVAL=1.0

# ======================
# Logging
# ======================
LOG_LEVEL=INFO

# ============================================================
# HƯỚNG DẪN NHANH
# ============================================================
# 
# Bước 1: Lấy GEMINI_API_KEY
#   - Truy cập: https://makersuite.google.com/app/apikey
#   - Đăng nhập Google
#   - Tạo API key mới (miễn phí)
#   - Copy và paste vào GEMINI_API_KEY ở trên
#
# Bước 2: Ingest dữ liệu vào ChromaDB
#   cd law-chatbot-backend
#   python scripts/quick_ingest.py
#
# Bước 3: Chạy server
#   python main.py
#
# Bước 4: Test
#   curl -X POST http://localhost:8000/chat \
#     -H "Content-Type: application/json" \
#     -d '{"session_id": "test", "message": "Nguyên tắc phòng cháy là gì?"}'
#
# ============================================================
